# Single env file for the application (website, api, migrations, docker compose).
# Test modules (apps/ai-evaluation, apps/website-e2e) keep their own .env with separate credentials.

# --- Infrastructure ---
RABBITMQ_URL=amqp://localhost:5672
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_applicator
STORAGE_DIR=/app/uploads
ENABLE_QUERY_LOG=false

# --- Website / Supabase ---
NEXT_PUBLIC_SUPABASE_URL=<your-public-supabase-url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- API / AI models ---
# Optional provider overrides; omit to keep automatic selection.
# Job evaluator / CV parser: gemini, ollama, ai_gateway.
# Cover letter generator / critique: ollama, ai_gateway.
# JOB_EVALUATOR_PROVIDER=ollama
# CV_PARSER_PROVIDER=ollama
# COVER_LETTER_GENERATOR_PROVIDER=ollama
# CRITIQUE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
OLLAMA_JOB_EVALUATOR_MODEL=<ollama-model>
CV_PARSER_MODEL=<ollama-model>
COVER_LETTER_GENERATOR_MODEL=<ollama-model>
CRITIQUE_MODEL=<ollama-model>
# GEMINI_API_KEY=<your-gemini-key>
# COHERE_API_KEY=<your-cohere-key>
# COHERE_EMBEDDING_MODEL=embed-v4.0
AI_GATEWAY_API_KEY=<your-api-key-here>
AI_GATEWAY_JOB_EVALUATOR_MODEL=<model-name>
AI_GATEWAY_COVER_LETTER_GENERATOR_MODEL=<model-name>
AI_GATEWAY_CRITIQUE_MODEL=<model-name>
AI_GATEWAY_CV_PARSER_MODEL=<model-name>

# --- LangSmith tracing ---
LANGSMITH_PROJECT=<your-langsmith-project>
LANGSMITH_API_KEY=<your-langsmith-key>
LANGSMITH_TRACING=true

# --- Observability (New Relic) ---
# NEWRELIC_LICENSE_KEY=<your-newrelic-license-key>
# NEWRELIC_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net
