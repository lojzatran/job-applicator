LANGSMITH_API_KEY=<your-langsmith-key>
LANGSMITH_TRACING=true
GRADER_LLM_MODEL=gemma-4-31b-it
LLM_MODEL=gemma4:e4b
# Ollama embedding model for the full graph eval.
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
GEMINI_API_KEY=<your-gemini-key>

# Optional overrides for the embedding job evaluator. Defaults to the root .env settings.
# JOB_EVALUATOR_EMBEDDING_THRESHOLD=0.9
# EMBEDDING_PROVIDER=ai_gateway
# AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small
# AI_GATEWAY_EMBEDDING_DIMENSIONS=1024
# AI_GATEWAY_API_KEY=<your-ai-gateway-key>
